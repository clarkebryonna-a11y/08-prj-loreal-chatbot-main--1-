/* —— basic reset —— */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* —— brand colors, body, and fonts —— */
:root {
  --passionate-red: #b5121b;
  --eternal-gold: #c9a227;
  --iconic-black: #111111;
  --radiant-white: #ffffff;
}

body {
  font-family: "Montserrat", Arial, Helvetica, sans-serif;
  color: var(--iconic-black);
  min-height: 100vh;
  display: flex;
  justify-content: center;
  background:
    radial-gradient(circle at 8% 12%, rgba(181, 18, 27, 0.08), transparent 25%),
    radial-gradient(circle at 92% 88%, rgba(201, 162, 39, 0.12), transparent 28%),
    var(--radiant-white);
}

.page-wrapper {
  position: relative;
  overflow: hidden;
  width: 90%;
  max-width: 900px;
  min-height: 100vh;
  margin: 0 auto;
  padding: 0 42px;
  background: rgba(255, 255, 255, 0.94);
  border-left: 1px solid rgba(17, 17, 17, 0.08);
  border-right: 1px solid rgba(17, 17, 17, 0.08);
  box-shadow: 0 0 40px rgba(17, 17, 17, 0.08);
}

/* Header */
.site-header {
  position: relative;
  text-align: center;
  padding: 52px 0 30px;
  border-bottom: 1px solid rgba(17, 17, 17, 0.12);
}

.site-header::after {
  content: "";
  position: absolute;
  bottom: -2px;
  left: 50%;
  width: 92px;
  height: 3px;
  background: var(--eternal-gold);
  transform: translateX(-50%);
}

.brand-logo {
  display: block;
  width: min(220px, 70vw);
  height: auto;
  margin: 0 auto 22px;
}

.site-title {
  font-size: 22px;
  font-weight: 500;
  letter-spacing: 0.04em;
}

/* Chat area */
.chatbox {
  position: relative;
  z-index: 1;
  margin: 42px 0;
  padding: 26px;
  border-top: 5px solid var(--passionate-red);
  background: var(--radiant-white);
  box-shadow: 0 12px 30px rgba(17, 17, 17, 0.1);
}

.chat-window {
  height: 360px;
  border: 1px solid rgba(17, 17, 17, 0.2);
  padding: 20px;
  font-size: 18px;
  line-height: 1.5;
  overflow-y: auto;
  background: #fffdf9;
  white-space: pre-line;
}

/* messages */
.msg {
  margin-bottom: 14px;
  line-height: 1.5;
}

.msg.user {
  color: var(--iconic-black);
  font-weight: 500;
}

.msg.ai {
  color: var(--passionate-red);
}

/* Input row */
.chat-form {
  display: flex;
  gap: 12px;
  margin-top: 16px;
}

.chat-form input {
  flex: 1;
  padding: 12px;
  border: 1px solid rgba(17, 17, 17, 0.25);
  font-size: 18px;
}

.chat-form input:focus {
  outline: 2px solid var(--eternal-gold);
  outline-offset: 2px;
}

.chat-form button {
  font-size: 18px;
  background: var(--iconic-black);
  color: var(--radiant-white);
  border: none;
  padding: 12px;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background 0.3s;
}

.chat-form button .material-icons {
  font-size: 24px;
}

.chat-form button:hover {
  background: var(--passionate-red);
}

.chat-form button:focus {
  outline: 2px solid var(--eternal-gold);
  outline-offset: 2px;
}

/* visually hidden */
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* Footer */
.site-footer {
  margin: 60px 0 40px;
  padding-top: 22px;
  text-align: center;
  font-size: 14px;
  color: var(--iconic-black);
  border-top: 1px solid rgba(17, 17, 17, 0.12);
}

.site-footer nav {
  margin-top: 12px;
}

.site-footer a {
  margin: 0 8px;
  color: var(--passionate-red);
  text-decoration: none;
}

.site-footer a:hover {
  color: var(--eternal-gold);
}

@media (max-width: 600px) {
  .page-wrapper {
    width: 100%;
    padding: 0 18px;
    border: 0;
  }

  .chatbox {
    padding: 16px;
  }
}
